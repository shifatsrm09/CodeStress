# --- IBM Bob 2.0 / Ollama engine ---
# For local Ollama:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b

# For Ollama Cloud instead, set the base URL to https://ollama.com and provide a key:
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=your_ollama_cloud_key

# Optional: override the starting output-token budget for AI analysis (1024-8192)
# OLLAMA_ANALYSIS_OUTPUT_TOKENS=4096

# --- GitHub repo reading ---
# Raises the anonymous rate limit when reading public repos; required for private ones
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# --- GUI server ---
# GUI_PORT=9999